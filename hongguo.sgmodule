#!name=红果短剧与番茄全家桶去广告 (网络净化版)
#!desc=拦截穿山甲 (Pangle) 及字节跳动广告分发与上报域名，恢复正常联网，避免 SSL Pinning 导致的网络断连。

[Rule]
# 1. 穿山甲 / 字节跳动移动广告 SDK 域名与数据上报拦截
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao-b.com,REJECT
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT
DOMAIN-SUFFIX,pangle.io,REJECT
DOMAIN-SUFFIX,bytedance.ad,REJECT
DOMAIN,toblog.ctobsnssdk.com,REJECT
DOMAIN,mon.zijieapi.com,REJECT
DOMAIN-KEYWORD,pangolin,REJECT
DOMAIN-KEYWORD,ads-normal,REJECT

[Header Rewrite]
# 原生移除 Alt-Svc 响应头
^https?:\/\/.*\.fqnovel\.com\/.* header-del Alt-Svc
^https?:\/\/.*\.zijieapi\.com\/.* header-del Alt-Svc
^https?:\/\/.*\.snssdk\.com\/.* header-del Alt-Svc
^https?:\/\/.*\.amemv\.com\/.* header-del Alt-Svc
^https?:\/\/.*\.readingnovel\.com\/.* header-del Alt-Svc

[URL Rewrite]
# 拦截独立的广告配置拉取
^https?:\/\/.*\.(fqnovel|zijieapi|snssdk|amemv)\.com\/(reading\/)?(ad|union_ad|splash_ad|reward_ad)\/ - reject

[MITM]
# 注意：字节跳动中台 (snssdk/zijieapi/fqnovel) 在 iOS 开启了 SSL Pinning (证书绑定)
# 开启 MitM 会导致 App 检测到证书伪造直接中断网络 (报错'无网络')。
# 如需完美实现 VIP 与短剧免广告跳过，需配合 TrollFools / 侧载注入 fanqiehehe.dylib。
